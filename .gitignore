.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.db
*.sqlite3
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/
.env
.env.*
!.env.example
.DS_Store
build/
dist/
# Frontend design artifacts (managed in the design tool; not source)
/design/

# Dry-run send output (real .eml files, may contain recipient addresses)
outbox/

# Local database — leads and their audit trail.
workbench.db
workbench.db-*

# The versioned brief archive (app/store/brief_archive.py) — every real
# crawl, kept, never overwritten. Real local operator data, same reasoning
# as workbench.db: it belongs on the machine that did the research, not in
# version control. Root-anchored (leading /): an unanchored `briefs/`
# matches a directory of that name at ANY depth, including the real,
# committed fixture corpus at tests/fixtures/briefs/ — found the hard way,
# it silently broke `_refuse_if_untracked_fixtures()`'s own guard test by
# hiding that whole directory from `git status`.
/briefs/

# Cached Google Place photos.
.cache/

# Cached image dimensions.
.cache/imagesize/

# Commit message drafts, passed to `git commit -F`. Scaffolding, not history.
.commits/

# Working notes: feedback themes, debugging lessons, decisions not yet
# encoded in code or tests. Scaffolding for the work, not part of it.
.notes/

# Generated proof: screenshots and the contact sheet. Regenerated on demand by
# tools/contact_sheet.py, and a PNG per fixture per width is not history.
artifacts/

# The review bundle's photographs — copied from .cache/photos so the bundle
# opens with no server, regenerated on demand by tools/build_review.py. The
# pages and the index are small (linked, not inlined) and stay committed; a
# few hundred photographs at full width are not.
.reviews/review/photos/

# Left behind by the virtual machine a cloud session reached these files
# through: files deleted while the machine still held them open.
.fuse_hidden*

# graphify's per-file parse cache and its backup of settings it rewrote.
graphify-out/cache/
*.graphify-bak

# Design-run workspaces (app/design/bridge.py): photographs and a draft page,
# regenerated per run; what matters is saved as a version in workbench.db.
/runs/

# One folder per business, on this machine only (app/store/folders.py): its
# crawls, prompts, versions, master and proposals. The repository is public, and
# nothing that belongs to a business is kept in git.
/sites/
