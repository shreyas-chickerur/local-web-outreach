# Frontend design artifacts (managed in Claude design; not source)
design/

# Dry-run send output (real .eml files, may contain recipient addresses)
outbox/

# Local database — leads and their audit trail.
workbench.db
workbench.db-*

# Cached Google Place photos.
.cache/

# Cached image dimensions.
.cache/imagesize/

# Commit message drafts, passed to `git commit -F`. Scaffolding, not history.
.commits/

# Working notes: feedback themes, debugging lessons, decisions not yet
# encoded in code or tests. Scaffolding for the work, not part of it.
.notes/

# Generated proof: screenshots and the contact sheet. Regenerated on demand by
# tools/contact_sheet.py, and a PNG per fixture per width is not history.
artifacts/

# The review bundle's photographs — copied from .cache/photos so the bundle
# opens with no server, regenerated on demand by tools/build_review.py. The
# pages and the index are small (linked, not inlined) and stay committed; a
# few hundred photographs at full width are not.
.reviews/review/photos/
