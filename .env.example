# Copy this file to `.env` and fill in values. `.env` is gitignored — never
# commit real keys. The app loads `.env` automatically (python-dotenv).

# --- Database -------------------------------------------------------------
# Defaults to a local SQLite file if unset. Production target is Postgres:
# DATABASE_URL=postgresql+psycopg2:///local_web_outreach

# --- Places data source (Phase 2 live discovery) --------------------------
# The ONLY credential needed to run everything built so far on real data.
PLACES_PROVIDER=google
GOOGLE_PLACES_API_KEY=

# --- Second research source (strongly recommended) ------------------------
# Free key from https://www.yelp.com/developers/v3/manage_app — Yelp covers the
# local service businesses OpenStreetMap misses, which is what lets facts reach
# VERIFIED. OSM needs no key and is always used.
# YELP_API_KEY=

# --- Sender identity (email footer; required before any real send) --------
# SENDER_NAME=Your Business Name
# SENDER_POSTAL_ADDRESS=123 Main St, Frisco, TX 75034   # a REAL address (CAN-SPAM)

# --- Later phases (not needed yet) ---------------------------------------
# ANTHROPIC_API_KEY=          # Phase 3 research / generation
# STRIPE_SECRET_KEY=          # Phase 10 payments
# STRIPE_WEBHOOK_SECRET=

# --- Sending (Phase 7). Default is dry_run: writes .eml files, sends nothing.
SEND_MODE=dry_run
# SEND_ALLOWLIST=you@example.com     # required by self_test mode
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
DAILY_CAP_PER_INBOX=20
WARMUP_DAYS_REQUIRED=21
