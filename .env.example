# Copy to `.env`. Never commit real keys — `.env` is gitignored and a
# pre-commit hook blocks it.

# Google Places — the only source that reliably returns a business's own
# website, which is what answers "do they even have one?".
GOOGLE_PLACES_API_KEY=

# Yelp Fusion (free key) — covers the local service businesses that
# OpenStreetMap does not list. https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=

# OpenStreetMap needs no key and is always used.

# Where generated site previews will be served from (slice 3).
# PREVIEW_BASE_URL=http://127.0.0.1:8090
